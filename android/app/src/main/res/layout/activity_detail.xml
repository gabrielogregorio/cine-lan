<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grad_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grad_down" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="84dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="320dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingEnd="240dp"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:paddingEnd="300dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingEnd="300dp"
            android:textColor="@color/text_soft"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/watch" style="@style/AppButton" />
            <TextView android:id="@+id/do_start" style="@style/AppButton" android:text="Do começo" android:visibility="gone" />
            <TextView android:id="@+id/favorite" style="@style/AppButton" />
            <TextView android:id="@+id/buggy" style="@style/AppButton" />
            <TextView android:id="@+id/random" style="@style/AppButton" android:text="Episódio aleatório" android:visibility="gone" />
            <TextView android:id="@+id/similar" style="@style/AppButton" android:text="Parecidos" android:visibility="gone" />
        </LinearLayout>

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/seasons"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/title_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
