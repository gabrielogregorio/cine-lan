<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Só o canto superior direito tem imagem: pintar a tela cheia custa caro na GPU da Stick. -->
    <FrameLayout
        android:id="@+id/hero_area"
        android:layout_width="640dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/hero_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/hero_background_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/grad_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/grad_down" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="72dp"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/panel_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="262dp"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="300dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/hero_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="84dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxWidth="320dp"
                    android:scaleType="fitStart" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/title_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="264dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/text_search"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/results"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/state_retry"
                style="@style/AppButton"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="0dp"
                android:text="Tentar de novo" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="#F014161B"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />
</FrameLayout>
